<% content_for :title, "Pi Stats Dashboard" %>
<%# Stats poll every 60s in the background, but this page is a plain server
    render with no live client-side updates -- without this, a tab left open
    keeps showing whatever was true at the moment it was loaded, no matter how
    much new data has since accumulated. The refresh Stimulus controller
    (not a <meta http-equiv="refresh"> tag -- see its comment for why)
    reloads it on a timer so it stays current, and this same element's CSS
    animation draws a countdown bar to the next reload. %>
<% refresh_interval = 60 %>
<div
  class="refresh-progress"
  style="animation-duration: <%= refresh_interval %>s;"
  data-controller="refresh"
  data-refresh-interval-value="<%= refresh_interval %>"
  aria-hidden="true"
></div>
<%# pi_charcoal (#2b2b2b) was picked to match the light-theme text color, but
    that makes it nearly invisible as a chart line against the dark-theme
    background (#1a1a1a) -- which is exactly why the disk usage charts
    looked empty in dark mode: the line was there, just the same color as
    its background. pi_blue has real contrast against both themes. %>
<% pi_red = "#c51a4a"; pi_green = "#75b928"; pi_blue = "#3b7dd8" %>
<%
  # discrete: true is Chartkick's real option for "treat the x-axis as a
  # plain category scale" -- xtype: "string" (used here previously) isn't a
  # recognized option at all and silently does nothing; Chartkick instead
  # auto-detects the axis type from the label values. Our "MM/DD HH:MM:SS"
  # labels look like plain strings to us, but JS's lenient `new Date(...)`
  # constructor successfully parses them (defaulting to the year 2001), so
  # auto-detection was classifying the axis as "datetime" -- which needs a
  # Chart.js date-adapter package we don't vendor (see chart.js.js's own
  # comment for why), crashing with "Check that a complete date adapter is
  # provided." discrete: true overrides the detection and forces "string"
  # (category) treatment, which is what we've wanted all along.
  #
  # With a category scale, each chart's x-axis gets one tick per poll -- up
  # to 1,440 of them on the 24h range. Chart.js's autoSkip then discards
  # nearly all of them to avoid overlap, leaving the axis looking blank.
  # Force a small, always-legible, horizontal tick count instead, and label
  # the axis so it reads clearly as time.
  time_axis = {
    discrete: true,
    xtitle: "Time",
    library: { scales: { x: { ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 8 } } } }
  }
%>

<div class="dashboard" data-controller="width-toggle">
  <header class="dashboard-header">
    <h1>
      <span class="pi-logo" aria-hidden="true"></span>
      Raspberry Pi Dashboard
    </h1>

    <div class="header-controls">
      <nav class="range-selector" aria-label="Time range">
        <% DashboardController::RANGES.each_key do |key| %>
          <%= link_to key, root_path(range: key), class: "range-link #{"is-active" if key == @range_key}" %>
        <% end %>
      </nav>

      <button
        type="button"
        class="width-toggle-button"
        data-width-toggle-target="button"
        data-action="click->width-toggle#toggle"
        aria-pressed="false"
      >Full width</button>
    </div>
  </header>

  <section class="connectivity-section" aria-label="Internet connectivity">
    <div class="chart-card">
      <h2>Connectivity</h2>
      <% if @connectivity_status.empty? %>
        <p class="empty-state">Not checked yet &mdash; runs automatically every couple of minutes.</p>
      <% else %>
        <ul class="connectivity-list">
          <% @connectivity_status.each do |result| %>
            <li class="connectivity-row">
              <span class="connectivity-dot <%= result.reachable ? "is-up" : "is-down" %>" aria-hidden="true"></span>
              <span class="connectivity-host"><%= result.host %></span>
              <span class="connectivity-latency">
                <%= result.reachable ? "#{result.latency_ms} ms" : "unreachable" %>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </section>

  <% if (snapshot = @query.latest_snapshot).nil? %>
    <p class="empty-state">
      No stats have been collected yet. The background job polls every 60 seconds &mdash;
      check back in a minute, or run <code>Stats::SnapshotCollector.new.call</code> from the console.
    </p>
  <% else %>
    <section class="tiles" aria-label="Current stats">
      <div class="tile">
        <span class="tile-label">CPU</span>
        <%= render "gauge",
              value: snapshot.cpu_percent, min: 0, max: 100, yellow_at: 70, red_at: 90,
              label: "CPU usage",
              value_text: snapshot.cpu_percent ? number_to_percentage(snapshot.cpu_percent, precision: 1) : "&ndash;".html_safe,
              sub_text: nil %>
      </div>
      <div class="tile">
        <span class="tile-label">Memory</span>
        <%= render "gauge",
              value: snapshot.mem_percent, min: 0, max: 100, yellow_at: 70, red_at: 90,
              label: "Memory usage",
              value_text: number_to_percentage(snapshot.mem_percent, precision: 1),
              sub_text: "#{number_to_human_size(snapshot.mem_used_kb * 1024)} / #{number_to_human_size(snapshot.mem_total_kb * 1024)}" %>
      </div>
      <div class="tile">
        <span class="tile-label">Temperature</span>
        <%# Raspberry Pi OS starts throttling around 80C and hits its hard
            thermal limit near 85C, so those are the natural warn/crit
            thresholds here -- unlike the other gauges, this isn't a
            percentage, so the 0..100 range is just "degrees C", not "%". %>
        <%= render "gauge",
              value: snapshot.cpu_temp_celsius, min: 0, max: 100, yellow_at: 60, red_at: 80,
              label: "CPU temperature",
              value_text: snapshot.cpu_temp_celsius ? "#{number_with_precision(snapshot.cpu_temp_celsius, precision: 1)}°C" : "&ndash;".html_safe,
              sub_text: nil %>
      </div>
      <% @query.latest_disk_usages.each do |disk| %>
        <div class="tile">
          <span class="tile-label"><%= disk.mount_point %></span>
          <%= render "gauge",
                value: disk.use_percent, min: 0, max: 100, yellow_at: 80, red_at: 95,
                label: "Disk usage for #{disk.mount_point}",
                value_text: number_to_percentage(disk.use_percent, precision: 1),
                sub_text: "#{number_to_human_size(disk.used_bytes)} / #{number_to_human_size(disk.total_bytes)}" %>
        </div>
      <% end %>
      <% @query.latest_network_usages.each do |iface| %>
        <% if wifi_disconnected?(iface.interface, @wifi_status) %>
          <div class="tile is-wifi-disconnected">
            <span class="tile-label"><%= iface.interface %></span>
            <span class="tile-value">Wi-Fi off</span>
            <span class="tile-sub">Not connected</span>
          </div>
        <% else %>
          <div class="tile">
            <span class="tile-label"><%= iface.interface %></span>
            <span class="tile-value">
              <span class="net-rate">&darr; <%= iface.rx_bytes_per_sec ? number_to_human_size(iface.rx_bytes_per_sec) + "/s" : "&ndash;".html_safe %></span>
              <span class="net-rate">&uarr; <%= iface.tx_bytes_per_sec ? number_to_human_size(iface.tx_bytes_per_sec) + "/s" : "&ndash;".html_safe %></span>
            </span>
            <span class="tile-sub">
              &darr; <%= number_to_human_size(iface.rx_bytes_total) %> total &middot;
              &uarr; <%= number_to_human_size(iface.tx_bytes_total) %> total
            </span>
          </div>
        <% end %>
      <% end %>
    </section>

    <section class="charts" aria-label="Historical stats" data-controller="crosshair">
      <details class="chart-group" open>
        <summary>CPU</summary>
        <div class="chart-group-body">
          <div class="chart-card">
            <h2>CPU usage</h2>
            <%= line_chart @query.cpu_series, **time_axis, suffix: "%", min: 0, max: 100, colors: [pi_red] %>
          </div>

          <div class="chart-card">
            <h2>Temperature</h2>
            <%= line_chart @query.temperature_series, **time_axis, suffix: "°C", colors: [pi_red] %>
          </div>

          <div class="chart-card">
            <h2>Top CPU consumers</h2>
            <%= render "process_table",
                  processes: @top_cpu_processes,
                  value_label: "CPU",
                  value_for: ->(process) { number_to_percentage(process.cpu_percent, precision: 1) } %>
          </div>
        </div>
      </details>

      <details class="chart-group" open>
        <summary>Memory</summary>
        <div class="chart-group-body">
          <div class="chart-card">
            <h2>Memory usage</h2>
            <%= line_chart @query.memory_series, **time_axis, suffix: "%", min: 0, max: 100, colors: [pi_green] %>
          </div>

          <div class="chart-card">
            <h2>Top memory consumers</h2>
            <%= render "process_table",
                  processes: @top_memory_processes,
                  value_label: "Memory",
                  value_for: ->(process) { "#{number_to_human_size(process.rss_kb * 1024)} (#{number_to_percentage(process.mem_percent, precision: 1)})" } %>
          </div>
        </div>
      </details>

      <details class="chart-group" open>
        <summary>Disk</summary>
        <div class="chart-group-body">
          <% @query.disk_series_by_mount_point.each do |mount_point, series| %>
            <div class="chart-card">
              <h2>Disk usage &mdash; <%= mount_point %></h2>
              <%= line_chart(series, **time_axis, suffix: "%", min: 0, max: 100, colors: [pi_blue]) %>
            </div>
          <% end %>
        </div>
      </details>

      <details class="chart-group" open>
        <summary>Networking</summary>
        <div class="chart-group-body">
          <% @query.network_series_by_interface.each do |interface, series| %>
            <% if wifi_disconnected?(interface, @wifi_status) %>
              <div class="chart-card is-wifi-disconnected">
                <h2>Network &mdash; <%= interface %></h2>
                <p class="empty-state">Wi-Fi is disconnected &mdash; no data to chart.</p>
              </div>
            <% else %>
              <div class="chart-card">
                <h2>Network &mdash; <%= interface %></h2>
                <%= line_chart(series, **time_axis, suffix: "KBps", colors: [pi_green, pi_red]) %>
              </div>
            <% end %>
          <% end %>
        </div>
      </details>
    </section>
  <% end %>

  <footer class="dashboard-footer">
    <span><%= @system_info.model || "Unknown model" %></span>
    <span aria-hidden="true">&middot;</span>
    <span><%= @system_info.cpu_cores ? pluralize(@system_info.cpu_cores, "core") : "Unknown cores" %></span>
    <span aria-hidden="true">&middot;</span>
    <span><%= @system_info.os_version || "Unknown OS" %></span>
    <span aria-hidden="true">&middot;</span>
    <span>Kernel <%= @system_info.kernel_version || "unknown" %></span>
    <span aria-hidden="true">&middot;</span>
    <span><%= @system_info.hostname %></span>
  </footer>
</div>
