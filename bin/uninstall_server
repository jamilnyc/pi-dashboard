#!/usr/bin/env ruby
# Reverses bin/setup_server: stops, disables, and removes the systemd
# service it installed, then optionally cleans up the build/data it
# generated along the way.
#
# Safe to re-run: every step checks before it acts, so it's a no-op for
# anything already undone (e.g. the service was already removed by hand).
# The repo itself, its gem dependencies, and anything tracked by git are
# left untouched -- this only undoes what bin/setup_server did outside the
# repo (the systemd unit) and offers to clean up local, regenerable or
# irreplaceable state it created inside the repo (build output, the
# production database, generated credentials).

require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)
SERVICE_NAME = "pi-dashboard"
UNIT_PATH = "/etc/systemd/system/#{SERVICE_NAME}.service"

def system!(*args)
  system(*args, exception: true)
end

def confirm(question, default: false)
  suffix = default ? "Y/n" : "y/N"
  print "#{question} [#{suffix}]: "
  answer = $stdin.gets.to_s.strip.downcase
  return default if answer.empty?

  answer.start_with?("y")
end

FileUtils.chdir APP_ROOT do
  puts "== Pi Stats Dashboard: uninstall =="
  puts "Repo root: #{APP_ROOT}"

  puts "\n== Stopping and removing the systemd service =="
  if File.exist?(UNIT_PATH)
    puts "This next part needs sudo, to stop and remove the systemd service."
    # Plain `system` (not `system!`) throughout this block: a service that's
    # already stopped/disabled makes these exit non-zero, which isn't a
    # failure worth aborting the uninstall over.
    system("sudo", "systemctl", "stop", SERVICE_NAME)
    system("sudo", "systemctl", "disable", SERVICE_NAME)
    system!("sudo", "rm", "-f", UNIT_PATH)
    system!("sudo", "systemctl", "daemon-reload")
    system("sudo", "systemctl", "reset-failed", SERVICE_NAME)
    puts "Removed #{UNIT_PATH} and stopped the service."
  else
    puts "No unit installed at #{UNIT_PATH} -- nothing to stop or remove."
  end

  puts "\n== Precompiled assets =="
  if Dir.exist?("public/assets")
    system!({ "RAILS_ENV" => "production" }, "bin/rails", "assets:clobber")
    puts "Removed public/assets (regenerated next time you run assets:precompile)."
  else
    puts "No precompiled assets found -- nothing to remove."
  end

  puts "\n== Production database =="
  db_files = Dir.glob("storage/production*.sqlite3*")
  if db_files.empty?
    puts "No production database files found -- nothing to remove."
  elsif confirm("Delete the production database (#{db_files.size} file(s) under storage/, including all collected stat history)?")
    FileUtils.rm_f(db_files)
    puts "Deleted: #{db_files.join(', ')}"
  else
    puts "Keeping the production database."
  end

  puts "\n== Generated credentials =="
  master_key = "config/master.key"
  if !File.exist?(master_key)
    puts "No config/master.key found -- nothing to remove."
  elsif confirm("Delete config/master.key (generated by setup_server; irreversible -- anything encrypted with it becomes unreadable)?")
    FileUtils.rm_f(master_key)
    puts "Deleted #{master_key}."
    if system("git", "diff", "--quiet", "--", "config/credentials.yml.enc", out: File::NULL, err: File::NULL) == false
      if confirm("config/credentials.yml.enc was regenerated with that key and no longer matches git -- restore the version committed to this repo?")
        system!("git", "checkout", "--", "config/credentials.yml.enc")
        puts "Restored config/credentials.yml.enc from git."
      end
    end
  else
    puts "Keeping config/master.key."
  end

  puts "\n== Done =="
  puts "The repo itself, its bundled gems, and the SQLite dev/test databases were left alone."
end
